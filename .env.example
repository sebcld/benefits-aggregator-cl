# Copia este archivo como .env y completa los valores.

# Puerto de la API HTTP
PORT=3000

# Llave de subscripcion de la API de BCI (header ocp-apim-subscription-key).
# Se obtiene de las peticiones que hace el sitio https://www.bci.cl/beneficios a api.bciplus.cl.
BCI_SUBSCRIPTION_KEY=

# Token Bearer opcional para la API de Mercado Libre / Mercado Pago (sin token responde 403)
MELI_ACCESS_TOKEN=
MERCADOPAGO_TOKEN=
