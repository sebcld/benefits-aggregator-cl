# Copia este archivo como .env y completa los valores. Las variables del sistema tienen prioridad.
# Todas son opcionales salvo BCI_SUBSCRIPTION_KEY (sin ella BCI aparece como no disponible).

# --- Servidor HTTP ---
# Puerto de la API
PORT=3000
# API keys de los clientes que pueden usar la API, separadas por coma, con un nombre opcional:
#   API_KEYS=web:<llave>,movil:<llave>
# Con llaves, toda ruta exige "Authorization: Bearer <llave>" (o "x-api-key: <llave>") y responde
# 401 sin ella; solo GET /health queda abierto (health check). Vacio = sin autenticacion: SOLO para
# desarrollo local. Minimo 32 caracteres por llave. Para generar una:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# La llave "web" es la misma que BENEFITS_API_KEY en web/.env.local. Dos llaves a la vez permiten
# rotar sin cortar el servicio: agrega la nueva, cambia la web y luego quita la vieja.
API_KEYS=
# Nivel de log: debug | info | warn | error | silent (servidor: info; CLI: silent)
LOG_LEVEL=
# Origenes permitidos para CORS separados por coma, o * para todos. Vacio = CORS desactivado
# (las apps moviles nativas no lo necesitan).
CORS_ORIGINS=
# Tamano maximo del body en bytes
BODY_LIMIT_BYTES=1000000

# --- Cache y resiliencia (solo servidor HTTP; el CLI no usa cache ni timeouts) ---
# Segundos que se reutiliza el catalogo de cada emisor. 0 desactiva la cache.
CACHE_TTL_SECONDS=1800
# Antiguedad minima (segundos) para que /v1/search?refresh=true (boton "Actualizar" de la web)
# vuelva a descargar un catalogo. Evita que pulsar muchas veces castigue a las fuentes. 0 = sin minimo.
CACHE_REFRESH_MIN_AGE_SECONDS=300
# true = descarga los catalogos al iniciar el servidor (la primera busqueda ya es rapida)
CACHE_WARMUP=false
# Timeout por peticion HTTP a un emisor y por emisor completo (paginacion incluida), en ms
HTTP_TIMEOUT_MS=20000
PROVIDER_TIMEOUT_MS=60000

# --- Credenciales de emisores ---
# Llave de subscripcion de la API de BCI (header ocp-apim-subscription-key).
# Se obtiene de las peticiones que hace el sitio https://www.bci.cl/beneficios a api.bciplus.cl.
BCI_SUBSCRIPTION_KEY=
# Opcional: API key de r.jina.ai (proxy usado para Banco de Chile) para subir su limite de uso
JINA_API_KEY=
