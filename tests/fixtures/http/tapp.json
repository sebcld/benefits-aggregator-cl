       "locale": "es",
       "excerpt": "Pide tu pizza favorita en papajohns.cl o en la app y paga con tu tarjeta Tapp para obtener el dcto. ",
       "private": false,
       "category": "convenios",
       "segments": [],
       "created_at": "2023-05-03T18:47:31.000Z",
