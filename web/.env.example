# Copia este archivo como .env.local (no se sube al repositorio).
# Todas estas variables las lee SOLO el servidor de Next (BFF /api/*); el navegador nunca las ve.

# URL de la API de beneficios (/v1). En desarrollo: npm start en la raiz del repo.
BENEFITS_API_URL=http://localhost:3000

# API key de la API (ADR 0014, propuesto). Se envia como x-api-key solo si esta definida.
BENEFITS_API_KEY=

# Tiempo maximo de espera a la API, en ms (la API corta cada emisor a los 60 s).
BENEFITS_API_TIMEOUT_MS=65000

# Destino del enlace "Contacto" del header (publico: se incluye en el bundle del navegador).
NEXT_PUBLIC_CONTACT_URL=

# Solo `npm run dev`: hosts extra que pueden abrir el servidor de desarrollo, separados por coma.
# Las IPs de red local de este equipo ya se permiten solas (para probar desde el telefono).
DEV_ALLOWED_ORIGINS=
